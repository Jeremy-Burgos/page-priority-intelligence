# Page Priority Intelligence - example environment file
# Copy to .env for local use. NEVER commit a real .env.
# The CSV-only MVP does not require any of these. They are placeholders for the
# later API integration phase (Phase 4) and are documented here in advance.

# Default site origin used to convert GA4 landing-page paths into full URLs.
# Example: https://example.com  (no trailing slash)
PPI_SITE_DOMAIN=

# --- Optional AI recommendation writer (Phase 3). Leave blank to disable. ---
# The AI layer is optional. With no key the tool uses rule-based recommendations.
# Set ONE of these to enable the matching provider in the app.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional model overrides:
# PPI_OPENAI_MODEL=gpt-4o-mini
# PPI_CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Reserved for Phase 4 API integrations. Leave blank in the MVP. ---
# GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
# GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
# GA4_PROPERTY_ID=
# PAGESPEED_API_KEY=
# AHREFS_API_KEY=
# SEMRUSH_API_KEY=
